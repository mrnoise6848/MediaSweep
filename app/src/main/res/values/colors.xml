<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window background shown before Compose draws; must match
         ui.theme Color.BackgroundLight / BackgroundDark so the launch frame never
         flashes the wrong theme (specification Phase 10, dark/light theme). -->
    <color name="window_background_light">#F4F8F8</color>
    <color name="window_background_dark">#0D1314</color>
</resources>
