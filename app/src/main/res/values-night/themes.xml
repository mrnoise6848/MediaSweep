<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark mode: the pre-Compose window matches the dark Compose background so the
         launch frame and system bars never flip to light while the system is dark. -->
    <style name="Theme.MediaSweep" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background_dark</item>
    </style>
</resources>
